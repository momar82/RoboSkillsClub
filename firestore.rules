rules_version = '2';

// ===============================================================
// Assumed Data Model & Architecture: RoboSkillsClub
// Autonomous Mobile Robotics Training Platform
// ===============================================================
//
// 1. Collection: users
//    Document ID: {userId} (matches user UID e.g. student_*, teacher_*, super_admin_omar, admin_default)
//    Profile Fields:
//      - email: string (required, valid email, max 100 chars)
//      - displayName: string (required, 1-100 chars)
//      - role: string (required, 'student' | 'teacher' | 'admin' | 'super_admin')
//      - status: string (required, 'pending' | 'approved' | 'suspended')
//      - uid: string (optional, max 128 chars)
//      - username: string (optional, max 50 chars)
//      - password: string (optional, max 100 chars)
//      - mobileNumber: string (optional, max 25 chars)
//      - country: string (optional, max 100 chars)
//      - title: string (optional, max 150 chars)
//      - createdAt: timestamp / ISO time string (optional, immutable on update)
//      - updatedAt: timestamp / ISO time string (optional)
//      - institution: string (optional backward compatibility, max 150 chars)
//    Teacher-Specific Fields:
//      - organization: string (optional, max 150 chars)
//      - jobTitle: string (optional, max 100 chars)
//      - maxStudents: int (optional, 0-10000)
//      - approvedBy: string (optional, max 128 chars)
//      - assignedCourseIds: list of strings (optional, max 100 items)
//    Student-Specific Fields:
//      - educationLevel: string (optional, 'school' | 'university')
//      - schoolName: string (optional, max 150 chars)
//      - gradeYear: string (optional, max 50 chars)
//      - universityName: string (optional, max 150 chars)
//      - degreeLevel: string (optional, max 50 chars)
//      - major: string (optional, max 100 chars)
//      - enrolledCourseIds: list of strings (optional, max 100 items)
//      - assignedTeacherId: string (optional, max 128 chars)
//      - assignedTeacherName: string (optional, max 100 chars)
//      - profileCompleted: bool (optional)
//      - needsProfileCompletion: bool (optional)
//      - progress: number (optional, 0-100)
//      - submissions: int (optional, 0-1000)
//
// 2. Collection: courses
//    Document ID: {courseId}
//    Fields:
//      - title: string (required, 1-150 chars)
//      - description: string (required, 1-3000 chars)
//      - category: string (required, 1-50 chars)
//      - level: string (optional, 'beginner' | 'intermediate' | 'advanced')
//      - published: bool (required)
//      - authorId: string (optional, UID of creator, immutable)
//      - authorEmail: string (optional, valid email, max 100 chars)
//      - thumbnailUrl: string (optional, valid URL, max 500 chars)
//      - lessonCount: int (optional, 0-500)
//      - modules: list (optional, max 50 items)
//      - lessons: list (optional, max 200 items)
//      - assignedTeacherId: string (optional, UID of assigned teacher, max 128 chars)
//      - teacherIds: list of strings (optional, assigned teachers, max 50 items)
//      - createdAt: timestamp / ISO time string (required, immutable on update)
//      - updatedAt: timestamp / ISO time string (required)
//
//    Subcollection: courses/{courseId}/lessons/{lessonId}
//    Fields:
//      - title: string (required, 1-150 chars)
//      - order: int (required, 1-1000)
//      - content: string (required, curriculum markdown/text, max 50000 chars)
//      - courseId: string (required, matches parent courseId, immutable)
//      - moduleId: string (optional, max 100 chars)
//      - videoUrl: string (optional, valid URL, max 500 chars)
//      - durationMinutes: int (optional, 0-600)
//      - createdAt: timestamp / ISO time string (required, immutable on update)
//      - updatedAt: timestamp / ISO time string (required)
//
//    Subcollection: courses/{courseId}/modules/{moduleId}
//
// 3. Collection: enrollments
//    Document ID: {enrollmentId} (e.g. {userId}_{courseId} or unique ID)
//    Fields:
//      - userId: string (required, student UID, immutable)
//      - courseId: string (required, course ID, immutable)
//      - teacherId: string (optional, assigned teacher UID, max 128 chars)
//      - status: string (required, 'pending' | 'approved')
//      - completedLessons: list of strings (required, lesson IDs, max 200 items)
//      - progress: number (required, 0-100 percentage)
//      - enrolledAt: timestamp / ISO time string (required, immutable on update)
//      - approvedAt: timestamp / ISO time string (optional)
//      - lastUpdated: timestamp / ISO time string (optional)
//      - updatedAt: timestamp / ISO time string (optional)
//
// 4. Collection: submissions
//    Document ID: {submissionId}
//    Fields:
//      - studentId: string (required, student UID, immutable)
//      - studentEmail: string (required, student email, max 100 chars)
//      - studentName: string (required, 1-100 chars)
//      - courseId: string (required, course ID, max 128 chars, immutable)
//      - moduleId: string (required, 1-100 chars, immutable)
//      - lessonId: string (required, 1-100 chars, immutable)
//      - lessonNumber: int, string, or float (optional, e.g. "1.1" or 1)
//      - submissionText: string (optional, max 5000 chars)
//      - terminalOutput: string (optional, max 10000 chars)
//      - codeSnippet: string (optional, max 10000 chars)
//      - score: number (optional on create; 0-100 assigned by Teacher/Admin)
//      - feedback: string (optional, review feedback, max 2000 chars)
//      - status: string (required, 'pending' | 'submitted' | 'reviewed' | 'Graded' | 'Pending Review')
//      - dueDate: timestamp / ISO time string (optional)
//      - completedLessonAt: timestamp / ISO time string (optional)
//      - submittedAt: timestamp / ISO time string (required, immutable on update)
//      - reviewedAt: timestamp / ISO time string (optional)
//      - reviewedBy: string (optional, teacher UID/email, max 128 chars)
//
// 5. Collection: certificates
//    Document ID: {certificateId}
//    Fields:
//      - certificateId: string (required, 1-128 chars, immutable)
//      - studentId: string (required, student UID, immutable)
//      - studentName: string (required, 1-100 chars)
//      - courseId: string (required, course ID, 1-128 chars, immutable)
//      - courseTitle: string (required, 1-150 chars)
//      - issueDate: timestamp / ISO time string (required, immutable)
//      - verificationCode: string (required, unique verification code, 1-64 chars, immutable)
//      - grade: string or number (optional, e.g. 'Distinction' or score 0-100)
//      - instructorName: string (optional, 1-100 chars)
//
// 6. Collection: inquiries (Beta Applications)
//    Document ID: {inquiryId}
//    Fields:
//      - name: string (required, applicant name, 1-100 chars)
//      - email: string (required, valid email, max 100 chars)
//      - institution: string (required, school/university/team, 1-150 chars)
//      - team: string (optional, max 100 chars)
//      - studentCount: int (required, estimated students, 1-1000)
//      - message: string (optional, max 2000 chars)
//      - type: string (required, strictly 'beta_application')
//      - createdAt: timestamp / ISO time string (required, immutable on update)
//      - status: string (required, 'new' | 'contacted' | 'resolved')
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Super Admin Bypass & Default Root Protection
    // ===============================================================
    // Super Admin: m.omar82@gmail.com has global unrestricted bypass on all collections.
    // All other requests are denied unless explicitly matched and authorized below.
    match /{document=**} {
      allow read, write: if isAuthenticated() && request.auth.token.email == 'm.omar82@gmail.com';
    }

    // ===============================================================
    // Helper Functions: Authentication & Role-Based Access Control
    // ===============================================================

    // Check if caller is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Platform Super Admin: m.omar82@gmail.com
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'm.omar82@gmail.com';
    }

    // Check if caller's user document exists in /users/{uid}
    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Retrieve caller's user profile data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Admin role check: checks Super Admin, custom claims, or user profile doc
    function isAdmin() {
      return isSuperAdmin() ||
        (isAuthenticated() && (
          (request.auth.token.keys().hasAll(['role']) && request.auth.token.role in ['admin', 'super_admin']) ||
          (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) ||
          (hasUserDoc() && getUserData().role in ['admin', 'super_admin'] && getUserData().status == 'approved')
        ));
    }

    // Teacher role check: checks Admin hierarchy, custom claims, or user profile doc
    function isTeacher() {
      return isAdmin() ||
        (isAuthenticated() && (
          (request.auth.token.keys().hasAll(['role']) && request.auth.token.role == 'teacher') ||
          (request.auth.token.keys().hasAll(['teacher']) && request.auth.token.teacher == true) ||
          (hasUserDoc() && getUserData().role == 'teacher' && getUserData().status == 'approved')
        ));
    }

    // Check if a teacher is assigned to a course
    function isAssignedTeacherForCourse(courseId) {
      return isTeacher() && (
        isAdmin() ||
        (hasUserDoc() && ('assignedCourseIds' in getUserData()) && (courseId in getUserData().assignedCourseIds)) ||
        (resource != null && 'assignedTeacherId' in resource.data && resource.data.assignedTeacherId == request.auth.uid) ||
        (resource != null && 'teacherIds' in resource.data && (request.auth.uid in resource.data.teacherIds)) ||
        (resource != null && 'authorId' in resource.data && resource.data.authorId == request.auth.uid) ||
        (exists(/databases/$(database)/documents/courses/$(courseId)) && (
          ('authorId' in get(/databases/$(database)/documents/courses/$(courseId)).data &&
           get(/databases/$(database)/documents/courses/$(courseId)).data.authorId == request.auth.uid) ||
          ('assignedTeacherId' in get(/databases/$(database)/documents/courses/$(courseId)).data &&
           get(/databases/$(database)/documents/courses/$(courseId)).data.assignedTeacherId == request.auth.uid) ||
          ('teacherIds' in get(/databases/$(database)/documents/courses/$(courseId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/courses/$(courseId)).data.teacherIds)
        ))
      );
    }

    // ===============================================================
    // Helper Functions: Validation Utilities
    // ===============================================================

    // Validate email address format and string size
    function isValidEmail(email) {
      return email is string &&
        email.size() >= 3 &&
        email.size() <= 100 &&
        email.matches("^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+$");
    }

    // Validate URL format (http:// or https://)
    function isValidUrl(url) {
      return url is string &&
        url.size() <= 500 &&
        (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    // Validate date string format (ISO 8601 or date format)
    function isValidDateString(dateStr) {
      return dateStr is string &&
        dateStr.size() <= 50 &&
        dateStr.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}.*$");
    }

    // Validate timestamp or date string
    function isValidTime(timeVal) {
      return timeVal is timestamp || isValidDateString(timeVal);
    }

    // Verify specified immutable fields have not been altered in an update operation
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators (Enforced on Create AND Update)
    // ===============================================================

    // Domain validator for users/{userId}
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'status']) &&
        data.keys().hasOnly([
          'uid', 'username', 'email', 'password', 'displayName', 'mobileNumber', 'country', 'role', 'status',
          'title', 'createdAt', 'updatedAt',
          // Teacher fields
          'organization', 'jobTitle', 'maxStudents', 'approvedBy', 'assignedCourseIds',
          // Student fields
          'educationLevel', 'schoolName', 'gradeYear', 'universityName', 'degreeLevel',
          'major', 'enrolledCourseIds', 'assignedTeacherId', 'assignedTeacherName',
          // Compatibility & progress fields
          'institution', 'profileCompleted', 'needsProfileCompletion', 'progress', 'submissions'
        ]) &&
        data.email is string &&
        isValidEmail(data.email) &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 100 &&
        data.role in ['student', 'teacher', 'admin', 'super_admin'] &&
        data.status in ['pending', 'approved', 'suspended'] &&
        (!('uid' in data) || data.uid == null || (data.uid is string && data.uid.size() <= 128)) &&
        (!('username' in data) || data.username == null || (data.username is string && data.username.size() <= 50)) &&
        (!('password' in data) || data.password == null || (data.password is string && data.password.size() <= 100)) &&
        (!('title' in data) || data.title == null || (data.title is string && data.title.size() <= 150)) &&
        (!('mobileNumber' in data) || data.mobileNumber == null || (data.mobileNumber is string && data.mobileNumber.size() <= 25)) &&
        (!('country' in data) || data.country == null || (data.country is string && data.country.size() <= 100)) &&
        (!('createdAt' in data) || data.createdAt == null || isValidTime(data.createdAt)) &&
        (!('updatedAt' in data) || data.updatedAt == null || isValidTime(data.updatedAt)) &&
        // Teacher fields constraints
        (!('organization' in data) || data.organization == null || (data.organization is string && data.organization.size() <= 150)) &&
        (!('jobTitle' in data) || data.jobTitle == null || (data.jobTitle is string && data.jobTitle.size() <= 100)) &&
        (!('maxStudents' in data) || data.maxStudents == null || (data.maxStudents is int && data.maxStudents >= 0 && data.maxStudents <= 10000)) &&
        (!('approvedBy' in data) || data.approvedBy == null || (data.approvedBy is string && data.approvedBy.size() <= 128)) &&
        (!('assignedCourseIds' in data) || data.assignedCourseIds == null || (data.assignedCourseIds is list && data.assignedCourseIds.size() <= 100)) &&
        // Student fields constraints
        (!('educationLevel' in data) || data.educationLevel == null || data.educationLevel in ['school', 'university']) &&
        (!('schoolName' in data) || data.schoolName == null || (data.schoolName is string && data.schoolName.size() <= 150)) &&
        (!('gradeYear' in data) || data.gradeYear == null || (data.gradeYear is string && data.gradeYear.size() <= 50)) &&
        (!('universityName' in data) || data.universityName == null || (data.universityName is string && data.universityName.size() <= 150)) &&
        (!('degreeLevel' in data) || data.degreeLevel == null || (data.degreeLevel is string && data.degreeLevel.size() <= 50)) &&
        (!('major' in data) || data.major == null || (data.major is string && data.major.size() <= 100)) &&
        (!('enrolledCourseIds' in data) || data.enrolledCourseIds == null || (data.enrolledCourseIds is list && data.enrolledCourseIds.size() <= 100)) &&
        (!('assignedTeacherId' in data) || data.assignedTeacherId == null || (data.assignedTeacherId is string && data.assignedTeacherId.size() <= 128)) &&
        (!('assignedTeacherName' in data) || data.assignedTeacherName == null || (data.assignedTeacherName is string && data.assignedTeacherName.size() <= 100)) &&
        // Compatibility & progress fields
        (!('institution' in data) || data.institution == null || (data.institution is string && data.institution.size() <= 150)) &&
        (!('profileCompleted' in data) || data.profileCompleted == null || data.profileCompleted is bool) &&
        (!('needsProfileCompletion' in data) || data.needsProfileCompletion == null || data.needsProfileCompletion is bool) &&
        (!('progress' in data) || data.progress == null || (data.progress is number && data.progress >= 0 && data.progress <= 100)) &&
        (!('submissions' in data) || data.submissions == null || (data.submissions is int && data.submissions >= 0 && data.submissions <= 1000));
    }

    // Domain validator for courses/{courseId}
    function isValidCourse(data) {
      return data.keys().hasAll(['title', 'description', 'category', 'published', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly([
          'title', 'description', 'category', 'level', 'published',
          'authorId', 'authorEmail', 'thumbnailUrl', 'lessonCount',
          'modules', 'lessons', 'assignedTeacherId', 'teacherIds',
          'createdAt', 'updatedAt'
        ]) &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 150 &&
        data.description is string &&
        data.description.size() >= 1 &&
        data.description.size() <= 3000 &&
        data.category is string &&
        data.category.size() >= 1 &&
        data.category.size() <= 50 &&
        data.published is bool &&
        (!('authorId' in data) || data.authorId == null || (data.authorId is string && data.authorId.size() <= 128)) &&
        (!('authorEmail' in data) || data.authorEmail == null || (data.authorEmail is string && isValidEmail(data.authorEmail))) &&
        (!('level' in data) || data.level == null || (data.level in ['beginner', 'intermediate', 'advanced'])) &&
        (!('thumbnailUrl' in data) || data.thumbnailUrl == null || isValidUrl(data.thumbnailUrl)) &&
        (!('lessonCount' in data) || data.lessonCount == null || (data.lessonCount is int && data.lessonCount >= 0 && data.lessonCount <= 500)) &&
        (!('modules' in data) || data.modules == null || (data.modules is list && data.modules.size() <= 50)) &&
        (!('lessons' in data) || data.lessons == null || (data.lessons is list && data.lessons.size() <= 200)) &&
        (!('assignedTeacherId' in data) || data.assignedTeacherId == null || (data.assignedTeacherId is string && data.assignedTeacherId.size() <= 128)) &&
        (!('teacherIds' in data) || data.teacherIds == null || (data.teacherIds is list && data.teacherIds.size() <= 50)) &&
        isValidTime(data.createdAt) &&
        isValidTime(data.updatedAt);
    }

    // Domain validator for courses/{courseId}/lessons/{lessonId}
    function isValidLesson(data, courseId) {
      return data.keys().hasAll(['title', 'order', 'content', 'courseId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'order', 'content', 'courseId', 'moduleId', 'videoUrl', 'durationMinutes', 'createdAt', 'updatedAt']) &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 150 &&
        data.order is int &&
        data.order >= 1 &&
        data.order <= 1000 &&
        data.content is string &&
        data.content.size() <= 50000 &&
        data.courseId == courseId &&
        (!('moduleId' in data) || data.moduleId == null || (data.moduleId is string && data.moduleId.size() <= 100)) &&
        (!('videoUrl' in data) || data.videoUrl == null || isValidUrl(data.videoUrl)) &&
        (!('durationMinutes' in data) || data.durationMinutes == null || (data.durationMinutes is int && data.durationMinutes >= 0 && data.durationMinutes <= 600)) &&
        isValidTime(data.createdAt) &&
        isValidTime(data.updatedAt);
    }

    // Domain validator for enrollments/{enrollmentId}
    function isValidEnrollment(data) {
      return data.keys().hasAll(['userId', 'courseId', 'status', 'completedLessons', 'progress', 'enrolledAt']) &&
        data.keys().hasOnly([
          'userId', 'courseId', 'teacherId', 'status',
          'completedLessons', 'progress', 'enrolledAt',
          'approvedAt', 'lastUpdated', 'updatedAt'
        ]) &&
        data.userId is string &&
        data.userId.size() >= 1 &&
        data.userId.size() <= 128 &&
        data.courseId is string &&
        data.courseId.size() >= 1 &&
        data.courseId.size() <= 128 &&
        (!('teacherId' in data) || data.teacherId == null || (data.teacherId is string && data.teacherId.size() <= 128)) &&
        data.status in ['pending', 'approved'] &&
        data.completedLessons is list &&
        data.completedLessons.size() <= 200 &&
        data.progress is number &&
        data.progress >= 0 &&
        data.progress <= 100 &&
        isValidTime(data.enrolledAt) &&
        (!('approvedAt' in data) || data.approvedAt == null || isValidTime(data.approvedAt)) &&
        (!('lastUpdated' in data) || data.lastUpdated == null || isValidTime(data.lastUpdated)) &&
        (!('updatedAt' in data) || data.updatedAt == null || isValidTime(data.updatedAt));
    }

    // Domain validator for submissions/{submissionId}
    function isValidSubmission(data) {
      return data.keys().hasAll(['studentId', 'studentEmail', 'studentName', 'courseId', 'moduleId', 'lessonId', 'status', 'submittedAt']) &&
        data.keys().hasOnly([
          'studentId', 'studentEmail', 'studentName', 'courseId', 'moduleId', 'lessonId', 'lessonNumber',
          'submissionText', 'terminalOutput', 'codeSnippet', 'score', 'feedback', 'status',
          'dueDate', 'completedLessonAt', 'submittedAt', 'reviewedAt', 'reviewedBy'
        ]) &&
        data.studentId is string &&
        data.studentId.size() >= 1 &&
        data.studentId.size() <= 128 &&
        data.studentEmail is string &&
        isValidEmail(data.studentEmail) &&
        data.studentName is string &&
        data.studentName.size() >= 1 &&
        data.studentName.size() <= 100 &&
        data.courseId is string &&
        data.courseId.size() >= 1 &&
        data.courseId.size() <= 128 &&
        data.moduleId is string &&
        data.moduleId.size() >= 1 &&
        data.moduleId.size() <= 100 &&
        data.lessonId is string &&
        data.lessonId.size() >= 1 &&
        data.lessonId.size() <= 100 &&
        (!('lessonNumber' in data) || data.lessonNumber == null ||
          (data.lessonNumber is int && data.lessonNumber >= 1 && data.lessonNumber <= 1000) ||
          (data.lessonNumber is string && data.lessonNumber.size() <= 20) ||
          (data.lessonNumber is float && data.lessonNumber >= 0)) &&
        (!('submissionText' in data) || data.submissionText == null || (data.submissionText is string && data.submissionText.size() <= 5000)) &&
        (!('terminalOutput' in data) || data.terminalOutput == null || (data.terminalOutput is string && data.terminalOutput.size() <= 10000)) &&
        (!('codeSnippet' in data) || data.codeSnippet == null || (data.codeSnippet is string && data.codeSnippet.size() <= 10000)) &&
        (!('score' in data) || data.score == null || (data.score is number && data.score >= 0 && data.score <= 100)) &&
        (!('feedback' in data) || data.feedback == null || (data.feedback is string && data.feedback.size() <= 2000)) &&
        data.status in ['pending', 'submitted', 'reviewed', 'Graded', 'Pending Review'] &&
        (!('dueDate' in data) || data.dueDate == null || isValidTime(data.dueDate)) &&
        (!('completedLessonAt' in data) || data.completedLessonAt == null || isValidTime(data.completedLessonAt)) &&
        isValidTime(data.submittedAt) &&
        (!('reviewedAt' in data) || data.reviewedAt == null || isValidTime(data.reviewedAt)) &&
        (!('reviewedBy' in data) || data.reviewedBy == null || (data.reviewedBy is string && data.reviewedBy.size() <= 128));
    }

    // Domain validator for certificates/{certificateId}
    function isValidCertificate(data) {
      return data.keys().hasAll(['certificateId', 'studentId', 'studentName', 'courseId', 'courseTitle', 'issueDate', 'verificationCode']) &&
        data.keys().hasOnly(['certificateId', 'studentId', 'studentName', 'courseId', 'courseTitle', 'issueDate', 'verificationCode', 'grade', 'instructorName']) &&
        data.certificateId is string &&
        data.certificateId.size() >= 1 &&
        data.certificateId.size() <= 128 &&
        data.studentId is string &&
        data.studentId.size() >= 1 &&
        data.studentId.size() <= 128 &&
        data.studentName is string &&
        data.studentName.size() >= 1 &&
        data.studentName.size() <= 100 &&
        data.courseId is string &&
        data.courseId.size() >= 1 &&
        data.courseId.size() <= 128 &&
        data.courseTitle is string &&
        data.courseTitle.size() >= 1 &&
        data.courseTitle.size() <= 150 &&
        isValidTime(data.issueDate) &&
        data.verificationCode is string &&
        data.verificationCode.size() >= 1 &&
        data.verificationCode.size() <= 64 &&
        (!('grade' in data) || data.grade == null || (data.grade is string && data.grade.size() <= 50) || (data.grade is number && data.grade >= 0 && data.grade <= 100)) &&
        (!('instructorName' in data) || data.instructorName == null || (data.instructorName is string && data.instructorName.size() <= 100));
    }

    // Domain validator for inquiries/{inquiryId}
    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'institution', 'studentCount', 'type', 'createdAt', 'status']) &&
        data.keys().hasOnly(['name', 'email', 'institution', 'team', 'studentCount', 'message', 'type', 'createdAt', 'status']) &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 100 &&
        data.email is string &&
        isValidEmail(data.email) &&
        data.institution is string &&
        data.institution.size() >= 1 &&
        data.institution.size() <= 150 &&
        (!('team' in data) || data.team == null || (data.team is string && data.team.size() <= 100)) &&
        data.studentCount is int &&
        data.studentCount >= 1 &&
        data.studentCount <= 1000 &&
        (!('message' in data) || data.message == null || (data.message is string && data.message.size() <= 2000)) &&
        data.type == 'beta_application' &&
        isValidTime(data.createdAt) &&
        data.status in ['new', 'contacted', 'resolved'];
    }

    // ===============================================================
    // 1. Users Collection
    // ===============================================================
    // Enables multi-device & multi-laptop account sync for students and teachers:
    // - Read: Public read access enabled to allow student/teacher clients across laptops
    //   to retrieve profiles, authenticate, and sync rosters.
    // - Create: Unauthenticated or authenticated creation with strict schema & data validation
    //   (role in ['student', 'teacher', 'admin', 'super_admin'], status in ['pending', 'approved', 'suspended']).
    // - Update: Unauthenticated or authenticated update with strict schema & data validation
    //   and immutable createdAt.
    // - Delete: Restricted to Super Admin and Admins.
    match /users/{userId} {
      allow read: if true;

      allow create: if isSuperAdmin() || isValidUser(request.resource.data);

      allow update: if isSuperAdmin() || (
        isValidUser(request.resource.data) &&
        (!('createdAt' in resource.data) || areImmutableFieldsUnchanged(['createdAt']))
      );

      allow delete: if isSuperAdmin() || isAdmin();
    }

    // ===============================================================
    // 2. Courses Collection & Lesson Curriculum
    // ===============================================================
    // Course catalog, modules, and lessons:
    // - Read: Allowed for all users (public and authenticated).
    // - Create: Admins and Super Admin.
    // - Update: Admins, Super Admin, and assigned teachers updating course materials.
    // - Delete: Admins and Super Admin.
    match /courses/{courseId} {
      allow read: if true;

      allow create: if isSuperAdmin() || (
        isAdmin() &&
        isValidCourse(request.resource.data) &&
        isValidTime(request.resource.data.createdAt) &&
        isValidTime(request.resource.data.updatedAt)
      );

      allow update: if isSuperAdmin() || (
        isValidCourse(request.resource.data) &&
        areImmutableFieldsUnchanged(['createdAt', 'authorId']) &&
        isValidTime(request.resource.data.updatedAt) &&
        (isAdmin() || isAssignedTeacherForCourse(courseId))
      );

      allow delete: if isSuperAdmin() || isAdmin();

      // Subcollection: Lessons
      match /lessons/{lessonId} {
        allow read: if true;

        allow create: if isSuperAdmin() || (
          isValidLesson(request.resource.data, courseId) &&
          isValidTime(request.resource.data.createdAt) &&
          isValidTime(request.resource.data.updatedAt) &&
          (isAdmin() || isAssignedTeacherForCourse(courseId))
        );

        allow update: if isSuperAdmin() || (
          isValidLesson(request.resource.data, courseId) &&
          areImmutableFieldsUnchanged(['createdAt', 'courseId']) &&
          isValidTime(request.resource.data.updatedAt) &&
          (isAdmin() || isAssignedTeacherForCourse(courseId))
        );

        allow delete: if isSuperAdmin() || isAdmin();
      }

      // Subcollection: Modules
      match /modules/{moduleId} {
        allow read: if true;

        allow create: if isSuperAdmin() || (isAdmin() || isAssignedTeacherForCourse(courseId));
        allow update: if isSuperAdmin() || (isAdmin() || isAssignedTeacherForCourse(courseId));
        allow delete: if isSuperAdmin() || isAdmin();
      }
    }

    // ===============================================================
    // 3. Enrollments Collection
    // ===============================================================
    // Student course enrollments and progress tracking across student & teacher laptops:
    // - Read: Public read access enabled to sync student enrollments across laptops.
    // - Create: Allowed with strict enrollment validation and valid enrolledAt time.
    // - Update: Allowed with strict validation and immutable userId, courseId, enrolledAt.
    // - Delete: Restricted to Super Admin and Admins.
    match /enrollments/{enrollmentId} {
      allow read: if true;

      allow create: if isSuperAdmin() || (
        isValidEnrollment(request.resource.data) &&
        isValidTime(request.resource.data.enrolledAt)
      );

      allow update: if isSuperAdmin() || (
        isValidEnrollment(request.resource.data) &&
        areImmutableFieldsUnchanged(['userId', 'courseId', 'enrolledAt'])
      );

      allow delete: if isSuperAdmin() || isAdmin();
    }

    // ===============================================================
    // 4. Submissions Collection
    // ===============================================================
    // Student challenge, assignment, and practical robotics submissions:
    // - Read: Allowed for synchronization between student and instructor laptops.
    // - Create: Strict validation of student fields, courseId, lessonId, and submittedAt.
    // - Update: Strict validation with immutable core studentId, courseId, lessonId, and submittedAt.
    // - Delete: Restricted to Super Admin and Admins.
    match /submissions/{submissionId} {
      allow read: if true;

      allow create: if isSuperAdmin() || (
        isValidSubmission(request.resource.data) &&
        isValidTime(request.resource.data.submittedAt)
      );

      allow update: if isSuperAdmin() || (
        isValidSubmission(request.resource.data) &&
        areImmutableFieldsUnchanged(['studentId', 'courseId', 'moduleId', 'lessonId', 'submittedAt'])
      );

      allow delete: if isSuperAdmin() || isAdmin();
    }

    // ===============================================================
    // 5. Certificates Collection
    // ===============================================================
    // Verifiable course completion certificates:
    // - Read: Public read allowed (to verify credentials via certificate link).
    // - Create: Valid certificate structure required.
    // - Update: Admins, Teachers, Super Admin with immutable core certificate fields.
    // - Delete: Admins and Super Admin.
    match /certificates/{certificateId} {
      allow read: if true;

      allow create: if isSuperAdmin() || isValidCertificate(request.resource.data);

      allow update: if isSuperAdmin() || (
        (isAdmin() || isTeacher()) &&
        isValidCertificate(request.resource.data) &&
        areImmutableFieldsUnchanged(['certificateId', 'studentId', 'courseId', 'verificationCode', 'issueDate'])
      );

      allow delete: if isSuperAdmin() || isAdmin();
    }

    // ===============================================================
    // 6. Inquiries Collection (Beta Applications)
    // ===============================================================
    // Applications for beta platform access from schools and teams:
    // - Read: Admins, Teachers, Super Admin.
    // - Create: Valid beta application inquiry with initial 'new' status.
    // - Update: Admins, Teachers, Super Admin with immutable type, createdAt, email.
    // - Delete: Admins and Super Admin.
    match /inquiries/{inquiryId} {
      allow read: if isSuperAdmin() || isAdmin() || isTeacher();

      allow create: if isValidInquiry(request.resource.data) &&
        request.resource.data.type == 'beta_application' &&
        request.resource.data.status == 'new' &&
        isValidTime(request.resource.data.createdAt);

      allow update: if isSuperAdmin() || (
        (isAdmin() || isTeacher()) &&
        isValidInquiry(request.resource.data) &&
        areImmutableFieldsUnchanged(['type', 'createdAt', 'email'])
      );

      allow delete: if isSuperAdmin() || isAdmin();
    }
  }
}
